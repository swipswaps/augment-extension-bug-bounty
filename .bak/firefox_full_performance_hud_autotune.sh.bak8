#!/usr/bin/env bash
# =============================================================================
# firefox_full_performance_hud_autotune.sh
# =============================================================================
# Live terminal HUD for Firefox prefs + CPU/GPU/Mesa + memory + disk
#
# READ-ONLY audit of Firefox runtime and prefs.js
# Generates a REVIEWABLE suggested_user.js in current directory
#
# DOES NOT modify Firefox profiles
# DOES NOT touch prefs.js
#
# Informed by:
#   - Mozilla prefs documentation & source comments
#   - Arkenfox user.js rules
#   - Betterfox performance tuning
#   - Mesa/WebRender stall analysis (Bugzilla / Phoronix)
#
# Verified: Firefox 147+ / Linux / X11 / Mesa (Intel & AMD)
# =============================================================================

set -euo pipefail

INTERVAL=5
SUGGESTED_JS="./suggested_user.js"

RED="\e[31m"
YELLOW="\e[33m"
GREEN="\e[32m"
CYAN="\e[36m"
MAGENTA="\e[35m"
RESET="\e[0m"

declare -A PREFS=(
  ["dom.ipc.processCount"]=4
  ["dom.ipc.processCount.web"]=4
  ["dom.ipc.keepProcessesAlive.web"]=1
  ["dom.min_background_timeout_value"]=1000
  ["dom.timeout.background_throttling_max_budget"]=5000
  ["gfx.webrender.all"]=true
  ["gfx.webrender.compositor"]=true
  ["gfx.webrender.wait-for-gpu"]=false
  ["gfx.webrender.enable-gpu-thread"]=false
  ["gfx.x11-egl.force-enabled"]=true
  ["gfx.gl.early-init"]=false
  ["gfx.gl.multithreaded"]=false
  ["layers.acceleration.force-enabled"]=true
  ["javascript.options.mem.max"]=4096
  ["javascript.options.mem.high_water_mark"]=2048
  ["javascript.options.gc_delay"]=2000
  ["browser.cache.disk.enable"]=true
  ["browser.cache.disk.smart_size.enabled"]=false
  ["browser.cache.disk.capacity"]=262144
  ["browser.sessionstore.interval"]=30000
  ["toolkit.telemetry.enabled"]=false
  ["toolkit.telemetry.unified"]=false
  ["datareporting.healthreport.uploadEnabled"]=false
)

MAX_CPU=70
MAX_MEM=50
MAX_JS_HEAP=3500
MAX_CACHE_MB=200
MIN_DOM_PROC=1

check_firefox() {
  pgrep -x 'firefox|firefox-bin' >/dev/null || {
    echo -e "${RED}Firefox is not running.${RESET}"
    exit 1
  }
}

select_firefox_profile() {
  mapfile -t profiles < <(
    find "$HOME/.mozilla/firefox" -maxdepth 2 -type f -name prefs.js | sort
  )

  [[ ${#profiles[@]} -eq 0 ]] && {
    echo -e "${RED}No Firefox profiles found.${RESET}"
    exit 1
  }

  local active
  active=$(find "$HOME/.mozilla/firefox" -maxdepth 1 -type d -name "*.default-release" \
           -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -n1 | awk '{print $2 "/prefs.js"}')

  [[ ! -f "$active" ]] && active="${profiles[0]}"

  echo -e "${CYAN}Available Firefox profiles:${RESET}"
  local i=1
  for p in "${profiles[@]}"; do
    [[ "$p" == "$active" ]] && echo -e "[$i] $p ${GREEN}(active)${RESET}" || echo "[$i] $p"
    ((i++))
  done

  echo
  read -rp "Select profile (Enter = active): " sel
  [[ -z "$sel" ]] && echo "$active" || echo "${profiles[$((sel-1))]}"
}

read_pref() {
  local val
  val=$(grep -Po "user_pref\\(\"$1\", \\K.*(?=\\));" "$2" 2>/dev/null || true)
  echo "${val//\"/}"
}

get_firefox_pids() {
  pgrep -x 'firefox|firefox-bin' || true
}

js_heap_mb() { pmap "$1" | awk '/total/ {print int($2/1024)}'; }
gpu_stalls() { ps -T -p "$1" -o stat | grep -c "D" || true; }

update_suggested_js() {
  local key="$1" val="$2"

  [[ ! -f "$SUGGESTED_JS" ]] && cat > "$SUGGESTED_JS" <<EOF
// ============================================================================
// suggested_user.js
// Generated by firefox_full_performance_hud_autotune.sh
// Review before applying
// ============================================================================
EOF

  if grep -q "user_pref(\"$key\"" "$SUGGESTED_JS"; then
    sed -i "s|user_pref(\"$key\".*)|user_pref(\"$key\", $val);|" "$SUGGESTED_JS"
  else
    echo "user_pref(\"$key\", $val);" >> "$SUGGESTED_JS"
  fi
}

auto_tune() {
  local prefs_file="$1"

  for pid in $(get_firefox_pids); do
    cpu=$(ps -p "$pid" -o %cpu= | awk '{print int($1)}')
    mem=$(ps -p "$pid" -o %mem= | awk '{print int($1)}')
    js=$(js_heap_mb "$pid")
    stalls=$(gpu_stalls "$pid")

    (( cpu > MAX_CPU )) && {
      cur=$(read_pref dom.ipc.processCount "$prefs_file")
      [[ -n "$cur" && $((cur-1)) -ge MIN_DOM_PROC ]] \
        && update_suggested_js dom.ipc.processCount "$((cur-1))"
    }

    (( js > MAX_JS_HEAP )) && {
      update_suggested_js javascript.options.mem.max "$((js+256))"
      update_suggested_js dom.timeout.background_throttling_max_budget 3000
    }

    (( mem > MAX_MEM )) && update_suggested_js dom.ipc.keepProcessesAlive.web 0

    (( stalls > 1 )) \
      && update_suggested_js gfx.webrender.enable-gpu-thread false \
      || update_suggested_js gfx.webrender.enable-gpu-thread true
  done
}

display_hud() {
  local prefs_file="$1"
  clear

  echo -e "${CYAN}Firefox Full Performance HUD${RESET}"
  echo "Suggested user.js: $SUGGESTED_JS"
  echo "------------------------------------------------------------"

  printf "%-50s %-12s %-12s %-8s\n" "Preference" "Desired" "Current" "Status"
  printf "%-50s %-12s %-12s %-8s\n" "--------------------------------------------------" "----------" "----------" "------"

  for key in "${!PREFS[@]}"; do
    desired="${PREFS[$key]}"
    current=$(read_pref "$key" "$prefs_file")

    if [[ -z "$current" ]]; then
      status="${RED}MISSING${RESET}"
      current="N/A"
    elif [[ "$current" == "$desired" ]]; then
      status="${GREEN}OK${RESET}"
    else
      status="${YELLOW}⚠${RESET}"
    fi

    printf "%-50s %-12s %-12s %-8b\n" "$key" "$desired" "$current" "$status"
  done
}

check_firefox
PREFS_FILE=$(select_firefox_profile)

while true; do
  display_hud "$PREFS_FILE"
  auto_tune "$PREFS_FILE"
  sleep "$INTERVAL"
done
