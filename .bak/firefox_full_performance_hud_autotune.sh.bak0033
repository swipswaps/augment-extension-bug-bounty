#!/usr/bin/env bash
# ==============================================================================
# Firefox Full Performance HUD + Autotune + Runtime Graphics Diagnostics
# + Live VAAPI decode + WebRender/WebGL/WebGPU validation (PRF-Compliant)
# Fully PRF-compliant, non-blocking, terminal-friendly
# ==============================================================================
set -euo pipefail
IFS=$'\n\t'

# ------------------------------------------------------------------------------
# Configuration
# ------------------------------------------------------------------------------
REFRESH_INTERVAL=5
MOZILLA_DIR="$HOME/.mozilla/firefox"
PROFILES_INI="$MOZILLA_DIR/profiles.ini"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/firefox-hud"
mkdir -p "$STATE_DIR"

RED=$'\e[31m'
GREEN=$'\e[32m'
YELLOW=$'\e[33m'
CYAN=$'\e[36m'
RESET=$'\e[0m'

SUPPORT_DUMP="$STATE_DIR/about_support.json"
MOZLOG_DUMP="$STATE_DIR/mozlog_graphics.txt"
VAAPI_LOG="$STATE_DIR/vaapi_test.txt"

# ------------------------------------------------------------------------------
# Resolve active Firefox profile
# ------------------------------------------------------------------------------
[[ -f "$PROFILES_INI" ]] || { echo "ERROR: profiles.ini not found"; exit 1; }
PROFILE_PATH=$(awk -F= '/^\[Profile/{p=1} p && /^Default=1/{d=1} d && /^Path=/{print $2; exit}' "$PROFILES_INI")
[[ -n "$PROFILE_PATH" ]] || { echo "ERROR: Unable to resolve profile"; exit 1; }
PROFILE_DIR="$MOZILLA_DIR/$PROFILE_PATH"
PREFS_FILE="$PROFILE_DIR/prefs.js"
USER_JS="$PROFILE_DIR/user.js"
[[ -f "$PREFS_FILE" ]] || { echo "ERROR: prefs.js missing"; exit 1; }

# ------------------------------------------------------------------------------
# Ensure user.js exists and explicitly set WebGL native GL
# ------------------------------------------------------------------------------
mkdir -p "$PROFILE_DIR"
touch "$USER_JS"
grep -q "webgl.prefer-native-gl" "$USER_JS" || \
  echo 'user_pref("webgl.prefer-native-gl", true);' >> "$USER_JS"

# ------------------------------------------------------------------------------
# Known defaults
# ------------------------------------------------------------------------------
declare -A KNOWN_DEFAULTS=(
  ["privacy.resistFingerprinting"]="false"
  ["network.dns.disablePrefetch"]="false"
  ["network.prefetch-next"]="true"
)

# ------------------------------------------------------------------------------
# Preference readers
# ------------------------------------------------------------------------------
read_prefs_js(){ grep -Po "user_pref\(\"$1\",\s*\K[^)]+" "$PREFS_FILE" | tr -d '";' | head -n1; }
read_user_js(){ [[ -f "$USER_JS" ]] || return 1; grep -Po "user_pref\(\"$1\",\s*\K[^)]+" "$USER_JS" | tr -d '";' | head -n1; }
resolve_pref(){
  local key="$1"
  local v_user v_prefs v_default
  v_user="$(read_user_js "$key" || true)"
  v_prefs="$(read_prefs_js "$key" || true)"
  v_default="${KNOWN_DEFAULTS[$key]:-}"
  if [[ -n "$v_user" ]]; then echo "$v_user|USER.JS"
  elif [[ -n "$v_prefs" ]]; then echo "$v_prefs|PREFS.JS"
  elif [[ -n "$v_default" ]]; then echo "$v_default|DEFAULT"
  else echo "|DEFAULT"; fi
}

# ------------------------------------------------------------------------------
# Preferences under observation
# ------------------------------------------------------------------------------
PREFS=(
  "gfx.gl.early-init|false"
  "gfx.webrender.all|true"
  "gfx.webrender.compositor|true"
  "layers.acceleration.force-enabled|true"
  "webgl.prefer-native-gl|true"
  "network.prefetch-next|true"
  "network.dns.disablePrefetch|false"
  "browser.cache.disk.enable|true"
  "browser.cache.disk.capacity|262144"
  "browser.sessionstore.interval|30000"
  "dom.ipc.processCount|8"
  "privacy.resistFingerprinting|false"
)

# ------------------------------------------------------------------------------
# Virtual display setup (Xvfb)
# ------------------------------------------------------------------------------
XVFB_PID=""
setup_virtual_display(){
  if [[ -z "${DISPLAY:-}" ]]; then
    Xvfb :99 -screen 0 1920x1080x24 >/dev/null 2>&1 &
    XVFB_PID=$!
    export DISPLAY=:99
    sleep 2
  fi
}

# ------------------------------------------------------------------------------
# MOZ_LOG capture
# ------------------------------------------------------------------------------
collect_mozlog(){
  timeout 60s env MOZ_LOG="Graphics:5" MOZ_LOG_FILE="$MOZLOG_DUMP" LIBGL_DEBUG=verbose \
    firefox --headless --profile "$PROFILE_DIR" about:blank >/dev/null 2>&1 || true
}

# ------------------------------------------------------------------------------
# About:support capture using Remote Debugging (poll until JSON ready)
# ------------------------------------------------------------------------------
collect_about_support(){
  tmpfile="$(mktemp)"
  REMOTE_PROFILE="$STATE_DIR/tmp-profile"
  rm -rf "$REMOTE_PROFILE"
  mkdir -p "$REMOTE_PROFILE"
  cp -r "$PROFILE_DIR"/* "$REMOTE_PROFILE"/

  # Start Firefox in background with proper env
  env MOZ_HEADLESS=0 LIBGL_DEBUG=verbose MOZ_LOG="Graphics:5" \
      firefox --profile "$REMOTE_PROFILE" --remote-debugging-port 9222 "about:support" &
  fpid=$!
  # Wait for remote debugging JSON to be ready
  for i in {1..15}; do
    curl -s "http://localhost:9222/json" > /dev/null 2>&1 && break || sleep 1
  done
  # Poll JSON 3x to capture data
  for i in {1..3}; do
    curl -s "http://localhost:9222/json" >> "$tmpfile" || true
    sleep 1
  done
  kill "$fpid" 2>/dev/null || true
  mv "$tmpfile" "$SUPPORT_DUMP"
}

# ------------------------------------------------------------------------------
# VAAPI live decode test
# ------------------------------------------------------------------------------
check_vaapi(){
  if command -v vainfo >/dev/null 2>&1; then
    VAAPI_CAPS=$(vainfo 2>&1 | grep -E "VAProfile|VAEntrypoint")
  else
    VAAPI_CAPS="${YELLOW}vainfo not installed${RESET}"
  fi
  if command -v ffmpeg >/dev/null 2>&1; then
    ffmpeg -hide_banner -loglevel error \
      -hwaccel vaapi -i /usr/share/ffmpeg/testsrc_10s.mp4 -f null - 2>"$VAAPI_LOG"
    VAAPI_DECODE_OK=$(grep -i "vaapi" "$VAAPI_LOG" || echo "${YELLOW}Decode test failed${RESET}")
  else
    VAAPI_DECODE_OK="${YELLOW}ffmpeg not installed${RESET}"
  fi
  echo -e "$VAAPI_CAPS\n$VAAPI_DECODE_OK"
}

# ------------------------------------------------------------------------------
# Extract fields from about:support JSON
# ------------------------------------------------------------------------------
extract_support_field(){ 
  local val
  val="$(grep -Po '"'"$1"'"\s*:\s*"\K[^"]+' "$SUPPORT_DUMP" 2>/dev/null | head -n1 || true)"
  [[ -z "$val" ]] && val="${YELLOW}<not detected>${RESET}"
  echo "$val"
}

# ------------------------------------------------------------------------------
# Start HUD
# ------------------------------------------------------------------------------
setup_virtual_display
collect_mozlog
collect_about_support

while true; do
  clear
  echo "=============================================="
  echo "Firefox Full Performance HUD (Authoritative)"
  echo "Profile: $PROFILE_PATH"
  echo "prefs.js: $PREFS_FILE"
  echo "user.js : ${USER_JS:-<none>}"
  echo "Refresh : $REFRESH_INTERVAL seconds"
  echo "=============================================="

  # ---- Preferences Table ----
  printf "%-42s %-10s %-10s %-12s %-10s\n" "Preference" "Desired" "Current" "Source" "Status"
  echo "----------------------------------------------------------------------------"
  for entry in "${PREFS[@]}"; do
    IFS='|' read -r key desired <<< "$entry"
    resolved="$(resolve_pref "$key")"
    current="${resolved%%|*}"
    source="${resolved##*|}"
    if [[ -z "$current" ]]; then
      printf "%-42s %-10s %-10s %-12s %b\n" "$key" "$desired" "N/A" "$source" "${RED}UNKNOWN${RESET}"
    elif [[ "$current" == "$desired" ]]; then
      printf "%-42s %-10s %-10s %-12s %b\n" "$key" "$desired" "$current" "$source" "${GREEN}OK${RESET}"
    else
      printf "%-42s %-10s %-10s %-12s %b\n" "$key" "$desired" "$current" "$source" "${YELLOW}DIFF${RESET}"
    fi
  done

  # ---- Runtime Graphics ----
  echo
  echo "=== RUNTIME GRAPHICS DIAGNOSTICS (AUTHORITATIVE) ==="
  echo "WebGL Renderer     : $(extract_support_field 'WebGL 1 Driver Renderer')"
  echo "Compositing        : $(extract_support_field 'Compositing')"
  echo "Window Protocol    : $(extract_support_field 'Window Protocol')"
  echo "WebGPU Default     : $(extract_support_field 'WebGPU Default Adapter')"
  echo "WebGPU Fallback    : $(extract_support_field 'WebGPU Fallback Adapter')"

  # ---- VAAPI Decode ----
  echo
  echo "=== VAAPI Hardware Decode Check ==="
  check_vaapi

  # ---- Blocklist / Failures ----
  echo
  echo "Blocklist / Failures:"
  grep -E 'FEATURE_FAILURE|Blocklisted|glxtest' "$SUPPORT_DUMP" || echo "${YELLOW}<none>${RESET}"

  # ---- MOZ_LOG ----
  echo
  echo "=== MOZ_LOG GRAPHICS CAPTURE (OPTIONAL) ==="
  [[ -f "$MOZLOG_DUMP" ]] && tail -n 50 "$MOZLOG_DUMP" || echo "${YELLOW}No MOZ_LOG data${RESET}"

  # ---- Firefox Processes ----
  echo
  echo "=== FIREFOX PROCESSES (NON-AUTHORITATIVE) ==="
  ps -C firefox -o pid,%cpu,%mem,cmd --no-headers || true

  sleep "$REFRESH_INTERVAL"
done
