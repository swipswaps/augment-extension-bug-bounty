    line.trim() === '' ||
    line.trim().startsWith('//') ||
    /^user_pref\("[-a-zA-Z0-9.]+",\s*(true|false|\d+|"[^"]*")\);$/.test(line.trim())
  )
}

async function rotateBackups(filePath) {
  for (let i = MAX_BACKUPS - 1; i >= 1; i--) {
    const older = `${filePath}.backup.${i}`
    const newer = `${filePath}.backup.${i + 1}`
    if (fsSync.existsSync(older)) {
      await fs.rename(older, newer)
    }
  }

  if (fsSync.existsSync(filePath)) {
    await fs.copyFile(filePath, `${filePath}.backup.1`)
  }
}

async function firefoxRunning() {
  try {
    const { stdout } = await execFileAsync('pgrep', ['-x', 'firefox'])
    return stdout.trim().length > 0
  } catch {
    return false
  }
}

