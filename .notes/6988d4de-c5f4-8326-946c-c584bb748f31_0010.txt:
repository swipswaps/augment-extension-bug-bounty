app.get('/api/user-js', async (_req, res) => {
  try {
    const profilePath = path.join(FIREFOX_DIR)
    const userJSPath = path.join(profilePath, USER_JS)

    if (!fsSync.existsSync(userJSPath)) {
      return res.json({ content: '' })
    }

    const content = await fs.readFile(userJSPath, 'utf8')
    res.json({ content })
  } catch (err) {
    res.status(500).json(safeError(err))
  }
})

app.post('/api/user-js', async (req, res) => {
  try {
    if (await firefoxRunning()) {
      return res.status(409).json({
        error: 'Firefox must be closed before modifying user.js'
      })
    }

    const { content } = req.body

    if (!validateUserJS(content)) {
      return res.status(400).json({
        error: 'Invalid user.js content'
      })
    }

    const profilePath = path.join(FIREFOX_DIR)
    const userJSPath = path.join(profilePath, USER_JS)

    await rotateBackups(userJSPath)
    await fs.writeFile(userJSPath, content, 'utf8')

    res.json({ success: true })
  } catch (err) {
    res.status(500).json(safeError(err))
  }
})

